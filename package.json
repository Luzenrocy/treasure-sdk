{
  "name": "@treasure/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Treasure 插件 SDK — 插件与宿主通信的统一接口",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "treasure-sdk": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ruhua-simeng.css": "./dist/assets/ruhua-simeng.css"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.6.0"
  },
  "optionalDependencies": {
    "sql.js": "^1.11.0"
  }
}
